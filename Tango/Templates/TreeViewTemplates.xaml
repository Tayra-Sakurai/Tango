<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Tango.Templates.TreeViewTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango.Templates"
    xmlns:models="using:Maizuru.Models">
    <DataTemplate
        x:Key="TreeViewCategoryTemplate"
        x:DataType="models:Category">
        <TreeViewItem
            ItemsSource="{Binding Categories}"
            Content="{Binding Name}"/>
    </DataTemplate>

    <DataTemplate
        x:Key="NoCategoryTreeViewTemplate">
        <TreeViewItem x:Uid="NullCategoryTreeViewItem"/>
    </DataTemplate>

    <local:CategoryTreeViewTemplateSelector
        x:Key="CategoryTemplateSelector"
        BaseTemplate="{StaticResource TreeViewCategoryTemplate}"
        NullTemplate="{StaticResource NoCategoryTreeViewTemplate}"/>
</ResourceDictionary>
