<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Tango.Templates.SettingViewResourceDictionary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango.Templates"
    xmlns:local2="using:Tango"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    
    <DataTemplate
        x:Key="BoolSettingViewTemplate"
        x:DataType="local2:SettingDataBoolViewModel">
        <controls:SettingsCard
            Header="{Binding Name}"
            Description="{Binding Description}"
            HeaderIcon="{Binding Icon}">
            <ToggleSwitch
                IsOn="{Binding Value, Mode=TwoWay}"
                OnContent="{Binding OnLabel}"
                OffContent="{Binding OffLabel}" />
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate
        x:Key="TimeSettingViewTemplate"
        x:DataType="local2:SettingDataTimeSpanViewModel">
        <controls:SettingsCard
            Header="{Binding Name}"
            Description="{Binding Description}"
            HeaderIcon="{Binding Icon}">
            <TimePicker
                SelectedTime="{Binding Value, Mode=TwoWay}" />
        </controls:SettingsCard>
    </DataTemplate>

    <local:SettingViewDataTemplateSelector
        x:Key="SettingViewTemplateSelector"
        BoolTemplate="{StaticResource BoolSettingViewTemplate}"
        TimeSpanTemplate="{StaticResource TimeSettingViewTemplate}" />
</ResourceDictionary>
