<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Tango.Templates.ComboBoxTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango.Templates"
    xmlns:models="using:Maizuru.Models">
    <DataTemplate
        x:Key="PaymentMethodComboBoxTemplate"
        x:DataType="models:PaymentMethod">
        <TextBlock Text="{Binding Name, TargetNullValue=None}"/>
    </DataTemplate>
</ResourceDictionary>
