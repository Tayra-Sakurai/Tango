<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tango.ItemViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:te="using:Tango.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Uid="ItemDetailDesc"
            Grid.ColumnSpan="4"
            Style="{StaticResource BodyTextBlockStyle}"/>

        <TextBlock
            x:Uid="CategoryGuide"
            Grid.Row="1"
            Grid.ColumnSpan="4"
            Style="{StaticResource BodyTextBlockStyle}"/>

        <TreeView
            ItemTemplateSelector="{StaticResource CategoryTemplateSelector}"
            ItemsSource="{x:Bind viewModel.Categories}"
            SelectedItem="{x:Bind viewModel.Category, Mode=TwoWay}"
            Grid.Row="2"
            Grid.ColumnSpan="4"/>

        <CalendarDatePicker
            x:Uid="DatePicker"
            Date="{x:Bind viewModel.Date, Mode=TwoWay}"
            Grid.Row="3"/>

        <TimePicker
            x:Uid="TimePicker"
            Time="{x:Bind viewModel.Time, Mode=TwoWay}"
            Grid.Row="3"
            Grid.Column="1"/>

        <ComboBox
            x:Uid="PaymentMethodBox"
            SelectedItem="{x:Bind viewModel.PaymentMethod, Mode=TwoWay}"
            ItemsSource="{x:Bind viewModel.PaymentMethods}"
            Grid.Row="3"
            Grid.Column="2"
            ItemTemplate="{StaticResource PaymentMethodComboBoxTemplate}"/>

        <te:ValidationTextBox
            x:Uid="NameBox"
            Text="{x:Bind viewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="4"
            Grid.ColumnSpan="4"/>

        <TextBox
            x:Uid="DescBox"
            Grid.Row="5"
            Grid.ColumnSpan="4"
            AcceptsReturn="True"
            Text="{x:Bind viewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <te:ValidationNumberBox
            Grid.Row="6"
            Grid.ColumnSpan="4"
            x:Uid="IncomeBox"
            Value="{x:Bind viewModel.Income, Mode=TwoWay}"
            Property="Income"
            AcceptExpression="True"
            SmallChange="{x:Bind viewModel.SmallChange}"
            LargeChange="1"
            NotifyDataErrorInfo="{x:Bind viewModel}"/>

        <te:ValidationNumberBox
            Grid.Row="7"
            Grid.ColumnSpan="4"
            x:Uid="ExpenseBox"
            Value="{x:Bind viewModel.Expense, Mode=TwoWay}"
            Property="Expense"
            AcceptExpression="True"
            SmallChange="{x:Bind viewModel.SmallChange}"
            LargeChange="1"
            NotifyDataErrorInfo="{x:Bind viewModel}"/>

        <CommandBar
            Grid.Row="8"
            Grid.ColumnSpan="4">
            <AppBarButton
                Icon="Save"
                x:Uid="SaveButton"
                Command="{x:Bind viewModel.SaveCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RemoveButton">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource BaseTextBlockStyle}"
                                x:Uid="RemoveConfirmMessage"/>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind viewModel.RemoveCommand}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <local:Copyright
            Grid.Row="9"
            Grid.ColumnSpan="4"/>
    </Grid>
</Page>
