<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tango.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tango">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            IsSettingsVisible="False"
            x:Name="BaseNavigation"
            MenuItemsSource="{x:Bind pageLinkItems}">
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="local:PageLinkItem">
                    <NavigationViewItem Content="{x:Bind LinkText}" Icon="{x:Bind Icon}"/>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Frame
                x:Name="MainFrame"
                Padding="36"/>
        </NavigationView>
    </Grid>
</Window>
