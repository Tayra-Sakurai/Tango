<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tango.PaymentMethodsViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Maizuru.Models"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="ListViewPageDesc"
            Style="{StaticResource BodyTextBlockStyle}"/>

        <tv:TableView
            x:Name="SuperTable"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="Row"
            d:DataContext="{d:DesignInstance Type=models:PaymentMethod}"
            ItemsSource="{x:Bind viewModel.PaymentMethods}">
            <tv:TableView.Columns>
                <tv:TableViewNumberColumn x:Uid="IdColumn" Binding="{Binding Id}"/>
                <tv:TableViewTextColumn x:Uid="NameColumn" Binding="{Binding Name}" Width="*"/>
                <tv:TableViewNumberColumn x:Uid="BalanceColumn" Binding="{Binding Balance}"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <CommandBar
            Grid.Row="2">
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncButton"
                Command="{x:Bind viewModel.LoadCommand}"/>
            <AppBarButton
                Icon="Add"
                x:Uid="AddButton"
                Command="{x:Bind viewModel.AddCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RemoveButton">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                x:Uid="RemoveConfirmMessage"
                                Style="{StaticResource BaseTextBlockStyle}"/>
                            <Button
                                x:Uid="RemoveConfirmButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind viewModel.RemoveCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=SuperTable}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                Icon="More"
                x:Uid="DetailButton"
                Command="{x:Bind viewModel.InvokeCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=SuperTable}"/>
        </CommandBar>

        <local:Copyright
            Grid.Row="3"/>
    </Grid>
</Page>
