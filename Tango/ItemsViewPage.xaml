<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tango.ItemsViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Maizuru.Models"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            x:Uid="ListViewPageDesc"/>

        <tv:TableView
            x:Name="SuperTable"
            IsReadOnly="True"
            AutoGenerateColumns="False"
            Grid.Row="1"
            SelectionMode="Single"
            d:DataContext="{d:DesignInstance Type=models:Item}"
            ItemsSource="{x:Bind viewModel.Items}">
            <tv:TableView.Columns>
                <tv:TableViewNumberColumn x:Uid="IdColumn" Binding="{Binding Id}"/>
                <tv:TableViewDateColumn x:Uid="DateColumn" Binding="{Binding DateTimeOffset}"/>
                <tv:TableViewTimeColumn x:Uid="TimeColumn" Binding="{Binding DateTimeOffset.TimeOfDay}"/>
                <tv:TableViewTextColumn x:Uid="CategoryColumn" Binding="{Binding Category.Name}"/>
                <tv:TableViewTextColumn x:Uid="NameColumn" Binding="{Binding Name}" Width="*"/>
                <tv:TableViewTextColumn x:Uid="PaymentMethodColumn" Binding="{Binding PaymentMethod.Name}"/>
                <tv:TableViewNumberColumn x:Uid="IncomeColumn" Binding="{Binding Income}"/>
                <tv:TableViewNumberColumn x:Uid="ExpenseColumn" Binding="{Binding Expense}"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <TreeView
            ItemsSource="{x:Bind viewModel.Categories}"
            SelectedItem="{x:Bind viewModel.Category, Mode=TwoWay}"
            ItemTemplateSelector="{StaticResource CategoryTemplateSelector}"
            Grid.Row="2"/>

        <ComboBox
            ItemsSource="{x:Bind viewModel.PaymentMethods}"
            SelectedItem="{x:Bind viewModel.PaymentMethod, Mode=TwoWay}"
            Grid.Row="3"
            ItemTemplate="{StaticResource PaymentMethodComboBoxTemplate}"/>

        <TextBox
            x:Uid="SearchBox"
            Grid.Row="4"
            x:Name="SearchBox"/>

        <CommandBar Grid.Row="5">
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncButton"
                Command="{x:Bind viewModel.LoadCommand}"/>

            <AppBarButton
                Icon="Add"
                x:Uid="AddButton"
                Command="{x:Bind viewModel.AddCommand}"/>

            <AppBarButton
                Icon="Delete"
                x:Uid="RemoveButton">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                x:Uid="RemoveConfirmMessage"
                                Style="{StaticResource BaseTextBlockStyle}"/>
                            <Button
                                x:Uid="RemoveConfirmButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind viewModel.RemoveCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=SuperTable}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Icon="More"
                    x:Uid="DetailButton"
                    Command="{x:Bind viewModel.InvokeCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=SuperTable}"/>

                <AppBarButton
                    Icon="Zoom"
                    x:Uid="FilterButton"
                    Command="{x:Bind viewModel.FilterCommand}"
                    CommandParameter="{Binding Text, ElementName=SearchBox}"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <local:Copyright
            Grid.Row="6"/>
    </Grid>
</Page>
