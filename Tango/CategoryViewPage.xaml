<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tango.CategoryViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:te="using:Tango.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="CategoryDetailDesc"
            VerticalAlignment="Top"
            Style="{StaticResource BodyLargeTextBlockStyle}"/>

        <TreeView
            Grid.Row="1"
            ItemsSource="{x:Bind viewModel.Categories}"
            ItemTemplateSelector="{StaticResource CategoryTemplateSelector}"
            SelectedItem="{x:Bind viewModel.ParentCategory, Mode=TwoWay}"/>

        <te:ValidationTextBox
            x:Uid="NameBox"
            Grid.Row="2"
            Text="{x:Bind viewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Property="Name"
            NotifyDataErrorInfo="{x:Bind viewModel}"/>

        <CommandBar
            DefaultLabelPosition="Bottom"
            Grid.Row="3">
            <AppBarButton
                Icon="Save"
                x:Uid="SaveButton"
                Command="{x:Bind viewModel.SaveCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RemoveButton">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource BaseTextBlockStyle}"
                                x:Uid="RemoveConfirmMessage"/>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                x:Uid="RemoveConfirmButton"
                                Command="{x:Bind viewModel.RemoveCommand}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <local:Copyright
            Grid.Row="4"/>
    </Grid>
</Page>
