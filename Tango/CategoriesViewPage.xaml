<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tango.CategoriesViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock
            x:Uid="ListViewPageDesc"/>
        <TreeView
            Grid.Row="1"
            x:Name="CategoriesView"
            ItemsSource="{x:Bind viewModel.Categories}"
            ItemTemplate="{StaticResource TreeViewCategoryTemplate}"/>
        <CommandBar
            Grid.Row="2"
            DefaultLabelPosition="Bottom">
            <AppBarButton
                Icon="Sync"
                Command="{x:Bind viewModel.LoadCommand}"
                x:Uid="SyncButton"/>
            <AppBarButton
                Icon="Add"
                Command="{x:Bind viewModel.AddCommand}"
                x:Uid="AddButton"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RemoveButton">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource BaseTextBlockStyle}"
                                x:Uid="RemoveConfirmMessage"/>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind viewModel.RemoveCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=CategoriesView}"
                                x:Uid="RemoveConfirmButton"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                Icon="More"
                x:Uid="DetailButton"
                Command="{x:Bind viewModel.InvokeCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=CategoriesView}"/>
        </CommandBar>
        <local:Copyright
            Grid.Row="3"/>
    </Grid>
</Page>
