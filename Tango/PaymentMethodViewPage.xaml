<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tango.PaymentMethodViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tango"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:te="using:Tango.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            x:Uid="PaymentMethodDetailDesc"/>

        <te:ValidationTextBox
            Grid.Row="1"
            x:Uid="NameBox"
            Text="{x:Bind viewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Property="Name"
            NotifyDataErrorInfo="{x:Bind viewModel}"/>

        <NumberBox
            Grid.Row="2"
            IsEnabled="False"
            Value="{x:Bind viewModel.Balance}"
            x:Uid="RemainderBox"/>

        <TextBox
            Grid.Row="3"
            AcceptsReturn="True"
            x:Uid="DescBox"
            Text="{x:Bind viewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <CommandBar
            Grid.Row="4">
            <AppBarButton
                Icon="Save"
                x:Uid="SaveButton"
                Command="{x:Bind viewModel.SaveCommand}"/>

            <AppBarButton
                Icon="Delete"
                x:Uid="RemoveButton">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource BaseTextBlockStyle}"
                                x:Uid="RemoveConfirmMessage"/>
                            <Button
                                x:Uid="RemoveConfirmButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind viewModel.RemoveCommand}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <local:Copyright
            Grid.Row="5"/>
    </Grid>
</Page>
